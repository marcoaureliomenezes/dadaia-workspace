# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / build
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checking / linting
.mypy_cache/
.ruff_cache/

# Environment files
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Node / Playwright
node_modules/
playwright-report/
test-results/

# Root-level runtime projections / local harness files.
# dadaia-workspace is the source library, not a generated consumer workspace.
/CLAUDE.md
/opencode.json
/Makefile
/playwright.config.ts

# dadaia agent reports (absolute paths, not for version control)
.dadaia/reports/

# dadaia runtime projections and generated directories (never commit)
.dadaia/
.claude/
.agents/
.codex/
.opencode/
tests/e2e/panel/screenshots/
img/

# dadaia fcntl lock files (never commit — runtime only)
.dadaia/states/.ws_lock
.dadaia/states/ctx_locks/*.lock

# dadaia implementation locks and audit log (runtime artefacts)
.dadaia/locks/
.dadaia/logs/

# Security — never commit credentials or secrets
*.pem
*.key
*.p12
*.pfx
*.jks
.env.local
.env.production
secrets/
credentials/

# Python packaging / CI cache leftovers
pip-wheel-metadata/
*.whl

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Maintainer SDD release ledger remains local, but product law and memory are public.
# `specs/constitution.md` and `specs/memory/**` are first-class repository truth.
/specs/*
!/specs/constitution.md
!/specs/memory/
!/specs/memory/**
