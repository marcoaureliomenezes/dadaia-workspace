# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / build
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checking / linting
.mypy_cache/
.ruff_cache/
# import-linter default cache — a repo-hygiene violation in the working tree
# (v0.1.53 FR3). Run lint-imports with --no-cache (see setup.cfg header); this
# entry is defence-in-depth only, not a licence to create the directory.
.import_linter_cache/

# Environment files
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Node / Playwright
node_modules/
playwright-report/
test-results/

# Root-level runtime projections / local harness files.
# dadaia-workspace is the source library, not a generated consumer workspace.
/CLAUDE.md
/opencode.json
/Makefile
/playwright.config.ts

# dadaia agent reports (absolute paths, not for version control)
.dadaia/reports/

# dadaia runtime projections and generated directories (never commit)
.dadaia/
.claude/
.agents/
.codex/
.opencode/
tests/e2e/panel/screenshots/
img/

# xdist-parallel / scratch test-run artefacts (never commit; README documents the zone)
tests/tmp/*
!tests/tmp/README.md

# dadaia fcntl lock files (never commit — runtime only)
.dadaia/states/.ws_lock
.dadaia/states/ctx_locks/*.lock

# dadaia implementation locks and audit log (runtime artefacts)
.dadaia/locks/
.dadaia/logs/

# Security — never commit credentials or secrets
*.pem
*.key
*.p12
*.pfx
*.jks
.env.local
.env.production
secrets/
credentials/

# Python packaging / CI cache leftovers
pip-wheel-metadata/
*.whl

# Jupyter
.ipynb_checkpoints/
*.ipynb

# SDD product law and release gates are repository truth.
# Keep broad specs/ ignore as a privacy backstop, then opt in only canonical
# lifecycle artifacts that the gate, doctor, and agents must see in review/CI.
/specs/*
!/specs/constitution.md
!/specs/memory/
!/specs/memory/**
# Auditor reports are repository truth (canonical lifecycle: auditor MD is committed).
# Opt in ONLY *.md under specs/audits/<ts>/ — privacy backstop still hides any
# non-markdown artifact an audit might emit.
!/specs/audits/
!/specs/audits/*/
/specs/audits/*/*
!/specs/audits/*/*.md
# Architecture visual evidence is repository truth (v0.1.55 FR7: canonical UML
# diagrams as fenced ```mermaid blocks committed for GitHub + panel review). Opt in
# ONLY *.md under specs/assets/<group>/ — privacy backstop still hides any
# non-markdown artifact (no .svg/.mmd/binary is ever committed here per R-8).
!/specs/assets/
!/specs/assets/*/
/specs/assets/*/*
!/specs/assets/*/*.md
# Bug records are repository truth (bug-registration-guardrail mandates
# registration in specs/bugs/ with redacted content): opt in ONLY *.md.
!/specs/bugs/
/specs/bugs/*
!/specs/bugs/*.md
!/specs/bugs/*.jsonl
!/specs/bugs/_archive/
!/specs/bugs/_archive/*.md
# Backlog is PM-curated repository truth (backlog-ownership + release-governance;
# v0.1.49 FR1 — bug backlog-gitignored-governance-vacuous): opt in ONLY *.md, live
# entries + candidates.md + _archive durable copies, so the BL-* pre-commit scope and
# the CI backlog-doctor job exercise the real committed tree.
!/specs/backlog/
/specs/backlog/*
!/specs/backlog/*.md
!/specs/backlog/_archive/
/specs/backlog/_archive/*
!/specs/backlog/_archive/*.md
# remote-bugs/ is the remote-bug-report intake subtree (excluded by
# /specs/backlog/* above with no negation until now): opt in ONLY *.md,
# live entries + _archive durable copies, mirroring the backlog/_archive idiom.
!/specs/backlog/remote-bugs/
/specs/backlog/remote-bugs/*
!/specs/backlog/remote-bugs/*.md
!/specs/backlog/remote-bugs/_archive/
/specs/backlog/remote-bugs/_archive/*
!/specs/backlog/remote-bugs/_archive/*.md
!/specs/releases/
!/specs/releases/ACTIVE.md
!/specs/releases/*/
/specs/releases/*/*
# Bug gitignore-alpha-qa-review-untrackable: each alpha-N closes with a
# qa-engineer review committed to the branch (DADAIA.md §5) — the whitelist
# must include it or the law is silently defeated (v0.5.0's ALPHA-1-QA.md
# needed git add -f).
!/specs/releases/*/ALPHA-*-QA.md
!/specs/releases/*/SPEC.md
!/specs/releases/*/PLAN.md
!/specs/releases/*/TASKS.md
!/specs/releases/*/CLOSURE.md
!/specs/releases/*/GRILL.md
!/specs/releases/*/OQ-DECISIONS.md
# alpha/rc segment files (ADR-1/ADR-5): track the 4 canonical files per segment.
!/specs/releases/*/alpha-*/
/specs/releases/*/alpha-*/*
!/specs/releases/*/alpha-*/SPEC.md
!/specs/releases/*/alpha-*/PLAN.md
!/specs/releases/*/alpha-*/TASKS.md
!/specs/releases/*/alpha-*/CLOSURE.md
!/specs/releases/*/alpha-*/GRILL.md
!/specs/releases/*/alpha-*/OQ-DECISIONS.md
!/specs/releases/*/rc-*/
/specs/releases/*/rc-*/*
!/specs/releases/*/rc-*/SPEC.md
!/specs/releases/*/rc-*/PLAN.md
!/specs/releases/*/rc-*/TASKS.md
!/specs/releases/*/rc-*/CLOSURE.md
!/specs/releases/*/rc-*/GRILL.md
!/specs/releases/*/rc-*/OQ-DECISIONS.md
!/specs/_archive/
!/specs/_archive/releases/
!/specs/_archive/releases/*/
/specs/_archive/releases/*/*
!/specs/_archive/releases/*/SPEC.md
!/specs/_archive/releases/*/PLAN.md
!/specs/_archive/releases/*/TASKS.md
!/specs/_archive/releases/*/CLOSURE.md
!/specs/_archive/releases/*/alpha-*/
/specs/_archive/releases/*/alpha-*/*
!/specs/_archive/releases/*/alpha-*/SPEC.md
!/specs/_archive/releases/*/alpha-*/PLAN.md
!/specs/_archive/releases/*/alpha-*/TASKS.md
!/specs/_archive/releases/*/alpha-*/CLOSURE.md
!/specs/_archive/releases/*/rc-*/
/specs/_archive/releases/*/rc-*/*
!/specs/_archive/releases/*/rc-*/SPEC.md
!/specs/_archive/releases/*/rc-*/PLAN.md
!/specs/_archive/releases/*/rc-*/TASKS.md
!/specs/_archive/releases/*/rc-*/CLOSURE.md

# Operator private working draft — never commit
docs/00_medium_mine.md

# specs-evolution migration backups (FR-S04) — never tracked
specs_bkp/
**/specs_bkp/
