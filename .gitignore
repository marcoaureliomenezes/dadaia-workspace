/CLAUDE.md
/opencode.json
/Makefile
/playwright.config.ts

# dadaia agent reports (absolute paths, not for version control)
.dadaia/reports/

# dadaia runtime projections and generated directories (never commit)
.dadaia/
.claude/
.agents/
.codex/
.opencode/
tests/e2e/panel/screenshots/
img/

# xdist-parallel / scratch test-run artefacts (never commit; README documents the zone)
tests/tmp/*
!tests/tmp/README.md

# dadaia fcntl lock files (never commit — runtime only)
.dadaia/states/.ws_lock
.dadaia/states/ctx_locks/*.lock

# dadaia implementation locks and audit log (runtime artefacts)
.dadaia/locks/
.dadaia/logs/

# Security — never commit credentials or secrets
*.pem
*.key
*.p12
*.pfx
*.jks
.env.local
.env.production
secrets/
credentials/

# Python packaging / CI cache leftovers
pip-wheel-metadata/
*.whl

# Jupyter
.ipynb_checkpoints/
*.ipynb

# SDD product law and release gates are repository truth.
# Keep broad specs/ ignore as a privacy backstop, then opt in only canonical
# lifecycle artifacts that the gate, doctor, and agents must see in review/CI.
/specs/*
!/specs/constitution.md
!/specs/memory/
!/specs/memory/**
# Auditor reports are repository truth (canonical lifecycle: auditor MD is committed).
# Opt in ONLY *.md under specs/audits/<ts>/ — privacy backstop still hides any
# non-markdown artifact an audit might emit.
!/specs/audits/
!/specs/audits/*/
/specs/audits/*/*
!/specs/audits/*/*.md
# Architecture visual evidence is repository truth (v0.1.55 FR7: canonical UML
# diagrams as fenced ```mermaid blocks committed for GitHub + panel review). Opt in
# ONLY *.md under specs/assets/<group>/ — privacy backstop still hides any
# non-markdown artifact (no .svg/.mmd/binary is ever committed here per R-8).
!/specs/assets/
!/specs/assets/*/
/specs/assets/*/*
!/specs/assets/*/*.md
# Bug records are repository truth (bug-registration-guardrail mandates
# registration in specs/bugs/ with redacted content): opt in ONLY *.md.
!/specs/bugs/
/specs/bugs/*
!/specs/bugs/*.md
!/specs/bugs/*.jsonl
!/specs/bugs/_archive/
!/specs/bugs/_archive/*.md
# Backlog is PM-curated repository truth (backlog-ownership + release-governance;
# v0.1.49 FR1 — bug backlog-gitignored-governance-vacuous): opt in ONLY *.md, live
# entries + candidates.md + _archive durable copies, so the BL-* pre-commit scope and
# the CI backlog-doctor job exercise the real committed tree.
!/specs/backlog/
/specs/backlog/*
!/specs/backlog/*.md
!/specs/backlog/_archive/
/specs/backlog/_archive/*
!/specs/backlog/_archive/*.md
# remote-bugs/ is the remote-bug-report intake subtree (excluded by
# /specs/backlog/* above with no negation until now): opt in ONLY *.md,
# live entries + _archive durable copies, mirroring the backlog/_archive idiom.
!/specs/backlog/remote-bugs/
/specs/backlog/remote-bugs/*
!/specs/backlog/remote-bugs/*.md
!/specs/backlog/remote-bugs/_archive/
/specs/backlog/remote-bugs/_archive/*
!/specs/backlog/remote-bugs/_archive/*.md
# Bug gitignore-verdict-evidence-untrackable-fourth-recurrence: four recurrences of
# "a law-mandated release artifact needs its own whitelist line, or it is silently
# defeated" (ALPHA-*-QA.md, PRE-PR-REVIEW.md, reviews/, now verdicts/) proved the
# catch-all-plus-per-artifact-opt-in shape was itself the defect, not any missing
# line. Inverted once: the release tree is TRACKED BY DEFAULT below; only the
# narrow scratch/private-notes class the original catch-all ever actually hid
# (local-notes.md, tmp/ working dirs — see test_source_repo_hygiene.py) stays
# ignored. No future canonical artifact class (verdicts/, reviews/, alpha-N/rc-N
# segments, or anything else TASKS.md declares) ever needs a fifth whitelist line.
!/specs/releases/
!/specs/releases/**
/specs/releases/**/local-notes.md
/specs/releases/**/tmp/
!/specs/_archive/
!/specs/_archive/releases/
!/specs/_archive/releases/**
/specs/_archive/releases/**/local-notes.md

# Operator private working draft — never commit
docs/00_medium_mine.md

# specs-evolution migration backups (FR-S04) — never tracked
specs_bkp/
**/specs_bkp/
