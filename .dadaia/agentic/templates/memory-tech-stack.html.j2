<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Memory — Tech Stack — {{ project_name | default(context_name | default('Projeto')) }}</title>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
  <script>mermaid.initialize({ startOnLoad: true, theme: 'default' });</script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
           max-width: 960px; margin: 2rem auto; padding: 0 1.5rem; line-height: 1.55;
           color: #222; background: #fafafa; }
    h1, h2, h3 { color: #111; }
    h1 { border-bottom: 2px solid #333; padding-bottom: .3rem; }
    h2 { margin-top: 2.2rem; border-bottom: 1px solid #ddd; padding-bottom: .2rem; }
    section { margin-bottom: 2rem; }
    code, pre { background: #f0f0f0; padding: .1rem .3rem; border-radius: 3px; font-size: .9em; }
    pre { padding: .8rem 1rem; overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { padding: .5rem .7rem; border: 1px solid #ddd; text-align: left; vertical-align: top; }
    th { background: #eee; }
    .mermaid { background: #fff; padding: 1rem; border: 1px solid #ddd; border-radius: 4px; }
    .meta { color: #666; font-size: .9em; }
  </style>
</head>
<body>

<h1>Tech Stack Memory — {{ project_name | default(context_name | default('Projeto')) }}</h1>
<p class="meta">Última atualização: {{ today | default(last_updated_iso | default('—')) }} · Closure: {{ last_release_id | default('none') }}</p>

<section id="languages">
  <h2>Linguagens</h2>
  <table>
    <thead>
      <tr><th>Linguagem</th><th>Versão</th><th>Uso</th></tr>
    </thead>
    <tbody>
      {{ languages_rows | default('<tr><td colspan="3">Sem linguagens registradas.</td></tr>') }}
    </tbody>
  </table>
</section>

<section id="runtimes">
  <h2>Runtimes e ferramentas</h2>
  <table>
    <thead>
      <tr><th>Ferramenta</th><th>Versão</th><th>Função</th></tr>
    </thead>
    <tbody>
      {{ runtimes_rows | default('<tr><td colspan="3">Sem runtimes registrados.</td></tr>') }}
    </tbody>
  </table>
</section>

<section id="dependencies">
  <h2>Dependências aprovadas</h2>
  <table>
    <thead>
      <tr><th>Dependência</th><th>Versão</th><th>Camada</th><th>Justificativa</th></tr>
    </thead>
    <tbody>
      {{ dependencies_rows | default('<tr><td colspan="4">Sem dependências registradas.</td></tr>') }}
    </tbody>
  </table>
</section>

<section id="constraints">
  <h2>Restrições e proibições</h2>
  <p>Tecnologias explicitamente proibidas e por quê:</p>
  <ul>
    {{ constraints_bullets | default('<li>Sem restrições registradas.</li>') }}
  </ul>
</section>

<section id="commands">
  <h2>Comandos canônicos</h2>
  <p>Como rodar, testar, lintar e empacotar:</p>
  <pre><code>{{ canonical_commands | default('# Sem comandos canônicos registrados') }}</code></pre>
</section>

</body>
</html>
