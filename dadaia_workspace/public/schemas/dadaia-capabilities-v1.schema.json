{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dadaia-capabilities-v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "specs",
    "contexts",
    "workflows",
    "harnesses",
    "surfaces",
    "consumer_requirements",
    "certification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "dadaia-capabilities-v1"},
    "provider": {
      "type": "object",
      "required": ["name", "distribution_version"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "dadaia-workspace"},
        "distribution_version": {"type": "string", "minLength": 1}
      }
    },
    "specs": {
      "type": "object",
      "required": ["pattern_version", "status_tokens", "commands"],
      "additionalProperties": false,
      "properties": {
        "pattern_version": {"type": "integer", "minimum": 1},
        "status_tokens": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "contexts": {
      "type": "object",
      "required": ["states", "modes", "commands", "selection_contract"],
      "additionalProperties": false,
      "properties": {
        "states": {"type": "array", "items": {"type": "string"}},
        "modes": {"type": "array", "items": {"type": "string"}},
        "commands": {"type": "array", "minItems": 10, "items": {"type": "string"}},
        "selection_contract": {"const": "explicit-or-caller-owned-bind"}
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "command": {"type": "string", "pattern": "^dadaia lifecycle "}
        }
      }
    },
    "harnesses": {"type": "object"},
    "surfaces": {"type": "object"},
    "consumer_requirements": {"type": "object"},
    "certification": {
      "type": "object",
      "required": ["command", "schema_version", "deterministic_fake_workflows", "live_harness_canaries_required_for_release"],
      "additionalProperties": false,
      "properties": {
        "command": {"const": "dadaia certify --json"},
        "schema_version": {"const": "dadaia-certification-v1"},
        "deterministic_fake_workflows": {"const": true},
        "live_harness_canaries_required_for_release": {"const": true}
      }
    }
  }
}
