{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "export-v1",
  "title": "Workspace export v1",
  "description": "The JSON the export command writes, soft or the hard archive's `spec-contexts.json` member. `repo_url` is null for a repo with no remote; `state` is the registry's lowercase value.",
  "type": "object",
  "required": ["schema_version", "dadaia_version", "harnesses", "contexts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "export-v1"},
    "dadaia_version": {"type": "string", "minLength": 1},
    "harnesses": {"type": "array", "items": {"type": "string"}},
    "contexts": {"type": "array", "items": {"$ref": "#/$defs/context"}}
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": ["slug", "name", "state", "repo_url", "associated_repos"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["alive", "dead"]},
        "repo_url": {"type": ["string", "null"]},
        "associated_repos": {"type": "array", "items": {"$ref": "#/$defs/associated"}}
      }
    },
    "associated": {
      "type": "object",
      "required": ["slug", "url"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]}
      }
    }
  }
}
