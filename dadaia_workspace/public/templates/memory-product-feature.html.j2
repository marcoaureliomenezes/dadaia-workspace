<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Memory — Product — {{ feature_name }} ({{ context_name }})</title>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
  <script>mermaid.initialize({ startOnLoad: true, theme: 'default' });</script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
           max-width: 880px; margin: 2rem auto; padding: 0 1.5rem; line-height: 1.55;
           color: #222; background: #fafafa; }
    h1, h2, h3 { color: #111; }
    h1 { border-bottom: 2px solid #333; padding-bottom: .3rem; }
    h2 { margin-top: 2rem; border-bottom: 1px solid #ddd; padding-bottom: .2rem; }
    section { margin-bottom: 2rem; }
    code, pre { background: #f0f0f0; padding: .1rem .3rem; border-radius: 3px; font-size: .9em; }
    pre { padding: .8rem 1rem; overflow-x: auto; }
    img { max-width: 100%; border: 1px solid #ddd; border-radius: 4px; margin: .5rem 0; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { padding: .5rem .7rem; border: 1px solid #ddd; text-align: left; vertical-align: top; }
    th { background: #eee; }
    .mermaid { background: #fff; padding: 1rem; border: 1px solid #ddd; border-radius: 4px; }
    .meta { color: #666; font-size: .9em; }
    nav.crumbs { font-size: .85em; color: #666; margin-bottom: .5rem; }
    nav.crumbs a { color: #444; text-decoration: none; }
    nav.crumbs a:hover { text-decoration: underline; }
    ol.flow { padding-left: 1.6rem; }
    ol.flow li { margin: .5rem 0; }
  </style>
</head>
<body>

<nav class="crumbs"><a href="index.html">← Voltar ao catálogo</a></nav>

<h1>{{ feature_name }}</h1>
<p class="meta">{{ feature_subtitle }} · Última atualização: {{ last_updated_iso }} · Closure: {{ last_release_id }}</p>

<section id="purpose">
  <h2>Propósito</h2>
  {{ purpose_paragraphs }}
</section>

<section id="flow">
  <h2>Fluxo de uso</h2>
  <ol class="flow">
    {{ flow_steps }}
  </ol>
  {{ flow_mermaid_optional }}
</section>

<section id="trigger">
  <h2>Trigger típico</h2>
  <p>{{ typical_trigger }}</p>
</section>

<section id="differential">
  <h2>Diferencial</h2>
  <p>{{ differential }}</p>
</section>

<section id="runtime-state">
  <h2>Estado runtime tocado</h2>
  <ul>
    {{ runtime_state_bullets }}
  </ul>
</section>

<section id="dependencies">
  <h2>Dependências</h2>
  <ul>
    {{ dependencies_bullets }}
  </ul>
</section>

</body>
</html>
